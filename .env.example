DB_CLIENT=postgres
DATABASE_URL=postgresql://crm_app:change-me@127.0.0.1:5432/crm
DATABASE_SSL=false
SESSION_SECRET=change-me
DEFAULT_DEALERSHIP_ID=1

CRM_UI_MODE=react

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_REDIRECT_URI=https://your-crm-domain/api/ringcentral/oauth/callback
RINGCENTRAL_WEBHOOK_URL=https://your-crm-domain/api/ringcentral/webhooks
RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN=
RINGCENTRAL_SCOPES=ReadAccounts ReadCallLog ReadCallRecording ReadMessages ReadPresence RingOut SMS WebhookSubscriptions
RINGCENTRAL_FROM_NUMBER=
RINGCENTRAL_ACCESS_TOKEN=
RINGCENTRAL_RECORDINGS_DIR=/var/www/crm/data/ringcentral/recordings
RINGCENTRAL_MIN_STORED_CALL_SECONDS=10
RINGCENTRAL_SKIP_FORWARDED_CALLS=true
RINGCENTRAL_AUTO_STATUS_UPDATES=true
RINGCENTRAL_AI_CONFIDENCE_THRESHOLD=0.78
RINGCENTRAL_JOB_BATCH_SIZE=10
RINGCENTRAL_RECONCILE_HOURS=24
RINGCENTRAL_MAINTENANCE_PASSES=3
